# Chart 1: Revenue by Category
plt.figure(figsize=(10, 6))
rev_by_cat.plot(kind='bar', color='steelblue')
plt.title('Revenue by Category')
plt.xlabel('Category')
plt.ylabel('Revenue ($)')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig('revenue_by_category_chart.png')
plt.show()

